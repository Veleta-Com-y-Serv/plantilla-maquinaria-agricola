---
import Base from '../layouts/Base.astro';
import { site, semilla } from '../data/site';
---

<Base titulo="Página no encontrada">
  <section class="portada">
    <div class="portada-lado error-lado">
      <div class="plano" data-plano="curvas" data-semilla={semilla(site.nombre + '404')} aria-hidden="true"><canvas /></div>
      <p class="error-cifra" aria-hidden="true">404</p>
      <div class="titular">
        <p class="antetitulo">Página no encontrada</p>
        <h1 class="titulo-seccion">Este camino no lleva a ninguna finca</h1>
        <p class="entrada">Puede que el enlace esté mal o que la página se haya movido. Vuelve al inicio y lo buscamos desde allí.</p>
        <div class="botones">
          <a class="btn" href="/">Volver al inicio</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .error-lado { min-height: 70svh; gap: 1.5rem; }
  @media (min-width: 60rem) { .error-lado { padding-right: var(--margen-lado); } }
</style>
