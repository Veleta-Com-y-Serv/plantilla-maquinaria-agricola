---
// «Servicio en el campo» (la firma de la plantilla): la comarca en el plano. Un plano de curvas de nivel generado (canvas,
// nunca una foto ni un mapa real) con las zonas (`items` {titulo, texto?}) como chinchetas con su nombre en una etiqueta
// de tinta; la primera es el taller (rombo mandarina) y el área de servicio se filetea en mandarina alrededor de todas.
// Encima, la libreta de avería: `aviso.titulo` en la cabeza de tinta, el teléfono en grande, `aviso.texto` en una celda y
// dos teclas (llamar y WhatsApp). Debajo, la lista de zonas: las que tienen `texto` enlazan a su página /zonas/<slug>/.
// Las posiciones salen de una semilla con los nombres: siempre iguales con los mismos datos. Como mucho 8 chinchetas.
import { seccion, site, tel, whatsapp, semilla } from '../../data/site';
import { enlaceDe } from '../../lib/paginas';
import Banda from '../ui/Banda.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const c = site.contacto;
const zonas = (s?.items ?? []).filter((z) => String(z?.titulo ?? '').trim());
const semillaPlano = semilla(site.nombre + zonas.map((z) => z.titulo).join('|'));

// Posiciones de las chinchetas (en % del plano), lejos de la esquina donde va la libreta en escritorio.
function azar(a: number) { return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }
const r = azar(semillaPlano);
const base = { x: 34, y: 50 };
const resto = zonas.slice(1, 8);
const inicio = r() * Math.PI * 2;
const chinchetas = [
  { nombre: zonas[0] ? String(zonas[0].titulo) : site.nombre, url: zonas[0] ? enlaceDe(zonas[0]) : '', x: base.x, y: base.y, base: true, izq: false },
  ...resto.map((z, i) => {
    const ang = inicio + (i * Math.PI * 2) / resto.length + (r() - 0.5) * 0.5;
    const x = Math.max(7, Math.min(62, base.x + Math.cos(ang) * (19 + r() * 9)));
    const y = Math.max(11, Math.min(89, base.y + Math.sin(ang) * (26 + r() * 10)));
    return { nombre: String(z.titulo), url: enlaceDe(z), x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10, base: false, izq: x > 50 };
  }),
];
const wa = c.whatsapp ? whatsapp(c.whatsapp, 'Hola, tengo una avería en el campo. Os mando la ubicación: ') : '';
const avisoTitulo = s?.aviso?.titulo ?? '';
const avisoTexto = s?.aviso?.texto ?? '';
const libreta = !!(c.telefono || avisoTexto);
---

{
  s && (
    <Banda id={Astro.props.id} color="hoja">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} cabeza />
      <div class="comarca">
        <div class="plano comarca-plano" data-plano="completo" data-semilla={semillaPlano}>
          <canvas aria-hidden="true" />
          {chinchetas.map((p) => (
            <span class:list={['chincheta', { 'chincheta--base': p.base, 'chincheta--izq': p.izq }]} style={`left:${p.x}%;top:${p.y}%`}>
              <span class="chincheta-marca" aria-hidden="true" />
              {p.url ? <a class="chincheta-nombre" href={p.url}>{p.nombre}</a> : <span class="chincheta-nombre">{p.nombre}</span>}
            </span>
          ))}
        </div>
        {libreta && (
          <div class="libreta">
            <p class="libreta-cabeza">
              <span><Icono nombre="herramienta" tam={16} /> {avisoTitulo || 'Avería en el campo'}</span>
            </p>
            {c.telefono && <a class="libreta-grande" href={tel(c.telefono)}>{c.telefono}</a>}
            {avisoTexto && (
              <dl class="celdas cuadricula">
                <div>
                  <dt>Qué hacer</dt>
                  <dd>{avisoTexto}</dd>
                </div>
              </dl>
            )}
            {(c.telefono || wa) && (
              <div class:list={['teclas-pie', { 'sin-celdas': !avisoTexto }]}>
                {c.telefono && <a href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> Llamar</a>}
                {wa && <a href={wa} rel="noopener" target="_blank"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
              </div>
            )}
          </div>
        )}
      </div>
      {zonas.length > 0 && (
        <ul class="zonas-lista" aria-label="Dónde trabajamos">
          {zonas.map((z) => (
            <li>{enlaceDe(z) ? <a href={enlaceDe(z)}>{z.titulo}</a> : <span>{z.titulo}</span>}</li>
          ))}
        </ul>
      )}
    </Banda>
  )
}

<style>
  .teclas-pie.sin-celdas { border-top: 1px solid var(--tinta); }
  .celdas > div:only-child dd { font-weight: 400; font-size: .98rem; color: var(--tinta-2); }
</style>
